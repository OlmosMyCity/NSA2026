datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
  /// Supervisión desde Tierra: ve el resumen de la tripulación de sus misiones, sin valores clínicos.
  OPERATOR
}

/// Lugar donde se encuentra un tripulante, declarado por él o por el cirujano de vuelo.
enum CrewLocation {
  CREW_CABIN
  HABITAT
  ROVER
  EVA
  STORM_SHELTER
  MEDICAL_BAY
}

enum UserState {
  ACTIVE
  INACTIVE
}

enum Environment {
  SPACECRAFT
  STATION
  ROVER
  LUNAR_BASE
  MARS_BASE
}

enum MissionStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
}

enum HealthStatus {
  OK
  WARNING
  CRITICAL
}

enum IncidentCategory {
  MEDICAL
  RADIATION
  MISSION
}

enum IncidentSeverity {
  WARNING
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(USER)
  state        UserState @default(ACTIVE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  missions              Mission[]       @relation("MissionCreator")
  operatedMissions      Mission[]       @relation("MissionOperator")
  astronaut             Astronaut?
  acknowledgedIncidents Incident[]      @relation("IncidentAcknowledger")
  closedIncidents       Incident[]      @relation("IncidentCloser")
  issuedDirectives      Directive[]           @relation("DirectiveIssuer")
  invalidatedReadings   HealthReading[]       @relation("ReadingInvalidator")
  recordedReadings      HealthReading[]       @relation("ReadingRecorder")
  uploadedFaceSamples   AstronautFaceSample[] @relation("FaceSampleUploader")

  @@map("users")
}

model Mission {
  id          String        @id @default(uuid())
  name        String
  description String
  environment Environment   @default(LUNAR_BASE)
  status      MissionStatus @default(IN_PROGRESS)
  startDate   DateTime
  endDate     DateTime?
  patchUrl    String?
  createdById String
  createdBy   User          @relation("MissionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  /// Operador en Tierra responsable de la tripulación de esta misión.
  operatorId  String?
  operator    User?         @relation("MissionOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  astronauts Astronaut[]
  incidents  Incident[]

  @@index([operatorId])
  @@map("missions")
}

model Astronaut {
  id        String    @id @default(uuid())
  missionId String
  mission   Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId    String?   @unique
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  role      String
  age       Int
  photoUrl  String?
  currentLocation   CrewLocation?
  locationUpdatedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  readings    HealthReading[]
  incidents   Incident[]
  directives  Directive[]
  faceSamples AstronautFaceSample[]

  @@map("astronauts")
}

model AstronautFaceSample {
  id           String    @id @default(uuid())
  astronautId  String
  astronaut    Astronaut @relation(fields: [astronautId], references: [id], onDelete: Cascade)
  imageUrl     String
  label        String?
  embedding    Json
  qualityScore Float     @default(0)
  uploadedById String?
  uploadedBy   User?     @relation("FaceSampleUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([astronautId])
  @@map("astronaut_face_samples")
}

model HealthReading {
  id          String    @id @default(uuid())
  astronautId String
  // P6: sin borrado físico. Un astronauta con lecturas no se puede borrar (se desactiva con deletedAt).
  astronaut   Astronaut @relation(fields: [astronautId], references: [id], onDelete: Restrict)

  // 7 Indicadores Vitales (NASA Human Research Program)
  heartRateBpm  Int
  systolicMmHg  Int
  diastolicMmHg Int
  glucoseMgDl   Float
  temperatureC  Float
  spo2Pct       Float
  sleepHours    Float
  mood          Int

  // Diagnóstico clínico computado por evaluateReading
  status         HealthStatus @default(OK)
  alerts         Json         @default("[]")
  recommendation String?
  notes          String?

  takenAt   DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Obsoleto: usar isValid. Se conserva solo por las filas antiguas.
  deletedAt DateTime?

  // P1: los datos de salud solo se agregan. Una lectura errónea se invalida;
  // una corrección es una lectura nueva que apunta a la que reemplaza.
  isValid           Boolean        @default(true)
  invalidatedAt     DateTime?
  invalidatedReason String?
  invalidatedById   String?
  invalidatedBy     User?          @relation("ReadingInvalidator", fields: [invalidatedById], references: [id], onDelete: SetNull)
  recordedById      String?
  recordedBy        User?          @relation("ReadingRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  supersedesId      String?        @unique
  supersedes        HealthReading? @relation("ReadingCorrection", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy      HealthReading? @relation("ReadingCorrection")

  @@index([astronautId, takenAt])
  @@index([astronautId, isValid, takenAt])
  @@index([invalidatedById])
  @@index([recordedById])
  @@map("health_readings")
}

model Incident {
  id               String           @id @default(uuid())
  category         IncidentCategory
  type             String
  severity         IncidentSeverity
  status           IncidentStatus   @default(OPEN)
  title            String
  description      String
  astronautId      String?
  astronaut        Astronaut?       @relation(fields: [astronautId], references: [id], onDelete: SetNull)
  missionId        String?
  mission          Mission?         @relation(fields: [missionId], references: [id], onDelete: SetNull)
  source           String
  readingId        String?
  protocolId       String?
  metadata         Json             @default("{}")
  openedAt         DateTime         @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?            @relation("IncidentAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  closedAt         DateTime?
  closedById       String?
  closedBy         User?            @relation("IncidentCloser", fields: [closedById], references: [id], onDelete: SetNull)
  resolutionNotes  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  directives Directive[]

  @@index([status, type, astronautId])
  @@index([astronautId, openedAt])
  @@map("incidents")
}

model Directive {
  id             String    @id @default(uuid())
  astronautId    String
  astronaut      Astronaut @relation(fields: [astronautId], references: [id], onDelete: Cascade)
  issuedById     String?
  issuedBy       User?     @relation("DirectiveIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  incidentId     String?
  incident       Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  content        String
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([astronautId, createdAt])
  @@map("directives")
}
