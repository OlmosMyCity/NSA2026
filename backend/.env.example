# Configuración del Servidor
PORT=4000
NODE_ENV=development

# PostgreSQL de Supabase (Dashboard → Connect). Transaction pooler (6543) para la app · Session pooler (5432) para prisma db push
DATABASE_URL="postgresql://postgres.vgdoggcmvhywwrikdbpb:<password>@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.vgdoggcmvhywwrikdbpb:<password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# Autenticación JWT (sin valores por defecto en código)
JWT_SECRET="colocar_aqui_un_secreto_robusto_para_firmar_jwt"
JWT_EXPIRES_IN="24h"

# Supabase Storage para subida de imágenes (la service key solo vive en el backend)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
SUPABASE_STORAGE_BUCKET="artemis-assets"
