{
  "name": "artemis-iv-backend",
  "version": "1.0.0",
  "description": "Core REST API & Crew Health Monitoring Engine for Artemis IV",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed:sql": "tsx scripts/generateSeedSql.ts",
    "lint": "eslint ."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "artemis-iv",
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "nasa-space-apps"
  ],
  "author": "Artemis IV Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@prisma/client": "^6.4.1",
    "@vercel/blob": "^2.9.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.0.5"
  }
}
