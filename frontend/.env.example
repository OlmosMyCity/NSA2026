# URL base de la API REST del backend. Por defecto: http://localhost:4000/api en `next dev`
# y /api en producción (vercel.json o BACKEND_URL rewrites enrutan /api/* al backend).
NEXT_PUBLIC_API_HOST=http://localhost:4000/api
# Usado por el visor de trayectoria orbital (OrbitTrajectoryViewer)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Origen público del backend para rewrites en hosts independientes como Render (solo servidor).
# Cuando se define (p. ej. https://orbvital-nsa2026.vercel.app), /api/* se reenvía sin CORS.
# BACKEND_URL=https://orbvital-nsa2026.vercel.app

# true = backend simulado en el navegador (src/mocks) para auth, misiones,
# astronautas, lecturas, consola y subidas. Se resuelve en el build: con false no se incluye.
NEXT_PUBLIC_USE_MOCKS=false

# Minutos de vigencia de los signos vivos (igual que FRESHNESS_WINDOW_MIN del backend)
NEXT_PUBLIC_FRESHNESS_WINDOW_MIN=15

# Microservicios Python opcionales (ai/vision).
NEXT_PUBLIC_VISION_URL=http://localhost:8000

# Las imágenes se suben por el backend (POST /api/uploads/*), que guarda las credenciales de
# almacenamiento (Vercel Blob / Supabase). El frontend no necesita claves de Supabase.

