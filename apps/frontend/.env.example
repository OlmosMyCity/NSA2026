# URL base de la API REST del backend (Node.js/Express)
NEXT_PUBLIC_API_HOST=http://localhost:4000/api

# Alternar a true para trabajar desacoplado con datos simulados (mocks) durante desarrollo
NEXT_PUBLIC_USE_MOCKS=false

# Supabase Storage (S3) para subida de fotos de tripulantes y parches de misión
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=artemis-assets

