# URL base de la API REST del backend (Node.js/Express)
NEXT_PUBLIC_API_HOST=http://localhost:4000/api
# Usado por el visor de trayectoria orbital (OrbitTrajectoryViewer)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Alternar a true para trabajar desacoplado con datos simulados (mocks) durante desarrollo
NEXT_PUBLIC_USE_MOCKS=false

# Minutos de vigencia de los signos vivos (igual que FRESHNESS_WINDOW_MIN del backend)
NEXT_PUBLIC_FRESHNESS_WINDOW_MIN=15

# Microservicios Python opcionales (ai/vision).
NEXT_PUBLIC_VISION_URL=http://localhost:8000

# Supabase Storage (S3) para subida de fotos de tripulantes y parches de misión
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=artemis-assets

