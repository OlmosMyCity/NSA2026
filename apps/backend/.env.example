# Configuración del Servidor
PORT=4000
NODE_ENV=development

# PostgreSQL (Neon / PostgreSQL). Conexión pooler para la app y directa para prisma db push
DATABASE_URL="postgresql://<user>:<password>@<db-host>:5432/orbvital?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<db-direct-host>:5432/orbvital?sslmode=require"

# Autenticación JWT (sin valores por defecto en código)
JWT_SECRET="colocar_aqui_un_secreto_robusto_para_firmar_jwt"
JWT_EXPIRES_IN="24h"

# CORS y comunicación entre microservicios
ALLOWED_ORIGINS="http://localhost:3000,https://orbvital-nsa2026.vercel.app"
AI_SERVICE_TOKEN=""

# Almacenamiento de imágenes (Vercel Blob prioritario, respaldo Supabase Storage)
BLOB_READ_WRITE_TOKEN=""
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
SUPABASE_STORAGE_BUCKET="artemis-assets"

# Gemini Decisions API (gemini-decision-1, solo en servidor; nunca en el cliente)
GEMINI_API_KEY=""
DEMO_OFFLINE="false"
DECISION_API_MAX_CALLS="50"
